{"type":"item.completed","item":{"id":"item_664","type":"command_execution","command":"/usr/bin/zsh -lc 'cd . && cat v93_tmpl.py f93_tm.py f93_tm2.py 2>/dev/null | head -150'","aggregated_output":"import numpy as np\nfrom PIL import Image\nim = Image.open('images/fig_093.png').convert('RGB')\na = np.array(im).astype(int)\ndef show(cx, cy, r=7, title=''):\n    print(f\"--- {title} center=({cx},{cy}) ---\")\n    for y in range(int(cy)-r, int(cy)+r+1):\n        s=''\n        for x in range(int(cx)-r, int(cx)+r+1):\n            px = a[y,x]\n            mx,mn = int(px.max()), int(px.min())\n            if mx<150: s+='#'\n            elif mn>235: s+='.'\n            elif px[0]>150 and px[2]<120: s+='R'\n            elif px[2]>150 and px[0]<120: s+='U'\n            else: s+='o'\n        print(s)\n# unambiguous from big image:\nshow(312.5, 96, 6, 'open circle @675K (EuZn2Sb2)')\nshow(298.6, 108, 6, 'filled circle @650K (EuCd2Sb2)')\nshow(326.5, 82, 6, 'open star @700K (YbCd2Sb2)')\nshow(326.5, 155, 6, 'filled star @700K (YbZn2Sb2)')\nshow(284.5, 133.5, 6, 'candidate open star @625K')\nshow(284.5, 175.5, 6, 'candidate filled star @625K')\nimport numpy as np\nfrom PIL import Image\nfrom scipy.signal import fftconvolve\n\nim = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nR,G,B = im[:,:,0], im[:,:,1], im[:,:,2]\nblack = ((R<100)&(G<100)&(B<100)).astype(float)\nh, w = black.shape\n\ndef get_template(x0,x1,y0,y1):\n    t = black[y0:y1, x0:x1]\n    return t\n\n# templates centred on legend markers (from ASCII dumps)\nt_open = get_template(83, 99, 60, 68)      # open circle 16x8\nt_fill = get_template(86, 97, 77, 85)      # filled circle 11x8\nt_star = get_template(84, 99, 93, 103)     # star 15x10\n\ndef ncc_peaks(mask, tmpl, thr):\n    t = tmpl - tmpl.mean()\n    # sliding window mean/var over mask\n    th, tw = tmpl.shape\n    sum_t  = t.sum()\n    # use fftconvolve for window sums\n    win = np.ones((th, tw))\n    s0  = fftconvolve(mask, win, mode='same')\n    s1  = fftconvolve(mask*mask, win, mode='same')\n    n   = th*tw\n    mean = s0 / n\n    var  = np.maximum(s1/n - mean*mean, 1e-9)\n    num  = fftconvolve(mask, t[::-1,::-1], mode='same') - s0 * (tmpl.mean())\n    den  = np.sqrt(np.maximum(var*(n*tmpl.var()), 1e-9) * np.maximum(n*tmpl.var(), 1e-9))\n    score = num / np.sqrt(np.maximum(var * (n*tmpl.var()), 1e-9)) * 0 + (num - 0) / np.maximum(np.sqrt(var) * np.sqrt(n*tmpl.var()), 1e-9)\n    score = np.nan_to_num(score)\n    peaks = []\n    sc = score.copy()\n    while True:\n        i = np.argmax(sc)\n        if sc.flat[i] < thr: break\n        y, x = np.unravel_index(i, sc.shape)\n        peaks.append((x, y, sc.flat[i]))\n        y0,y1 = max(0,y-6), min(h,y+7); x0,x1 = max(0,x-6), min(w,x+7)\n        sc[y0:y1, x0:x1] = -9\n    return peaks\n\nfor name, t, thr in [('OPEN', t_open, 0.55), ('FILL', t_fill, 0.60), ('STAR', t_star, 0.45)]:\n    pk = ncc_peaks(black, t, thr)\n    pk.sort(key=lambda p: p[0])\n    print(f'=== {name}: {len(pk)} peaks')\n    for x,y,s in pk:\n        print(f'  ({x:6.1f},{y:6.1f}) s={s:.2f}')\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\nim = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nR,G,B = im[:,:,0], im[:,:,1], im[:,:,2]\nraw = (R<100)&(G<100)&(B<100)\n\n# CLEAN MASK: remove frame, ticks, caption, left labels, legend box\nm = raw.copy()\nH,W = m.shape\nfor y in [20,230,299]: m[max(0,y-2):y+3, :] = False\nfor x in [72,355]: m[:, max(0,x-2):x+3] = False\nm[231:, :] = False\nm[:, :74] = False\nm[:, 353:] = False\n# remove ticks: near-frame short segments. Ticks are within 8px of frame.\n# We'll remove any black pixel within 8px of the 4 frame lines (but keep data).\n# Data starts at x~100 (far from left frame x=72), y~200 (far from bottom y=230).\n# Ticks: bottom ticks above y=230 near x-grid; top ticks below y=20; left/right ticks.\n# Remove bottom tick band:\nm[222:231, :] = False   # bottom ticks (below data? data min y ~190). Careful: keep data.\n# Actually data goes down to y~221 at left. So don't remove 222-230 globally.\n# Instead remove ticks by: pixels within 10px of a frame line AND forming short vertical/horiz segment.\n# Simpler: remove top tick band (y 20-30) and left tick band (x 72-85) and right (x 345-355).\nm[21:31, :] = False      # top ticks  (data max height: open circle at y~82 min, so safe)\nm[:, 74:86] = False      # left ticks\nm[:, 344:353] = False    # right ticks\nm[223:231, :] = False    # bottom ticks (data max y ~221, so safe to remove below 223)\nm[22:123, 80:196] = False  # legend box\n\nprint('clean mask px:', m.sum())\n\ndef template(x0,x1,y0,y1):\n    t = raw[y0:y1, x0:x1].astype(float)  # use RAW (legend) for template shape\n    return t\n\n# templates from legend (isolated). Trim to tight bbox.\ndef tight(t):\n    ys,xs=np.where(t>0)\n    return t[ys.min():ys.max()+1, xs.min():xs.max()+1]\n\nt_open = tight(raw[60:68, 83:99])    # legend open circle\nt_fill = tight(raw[77:85, 86:98])    # legend filled circle\nt_star = tight(raw[93:103, 84:99])   # legend star\nprint('t_open', t_open.shape, 't_fill', t_fill.shape, 't_star', t_star.shape)\n\ndef ncc_match(mask, tmpl):\n    mask=mask.astype(float); tmpl=tmpl.astype(float)\n    th,tw = tmpl.shape\n    tm = tmpl - tmpl.mean()\n    # normalized template\n    tn = tm / (np.sqrt((tm**2).sum()) )\n    # sliding window normalization of mask\n    win = np.ones((th,tw))\n    s0 = ndimage.convolve(mask, win, mode='same')\n    s1 = ndimage.convolve(mask*mask, win, mode='same')\n    n = th*tw\n    mean = s0/n\n    var = np.maximum(s1/n - mean**2, 1e-12)\n    std = np.sqrt(var)\n    # numerator: sum over window of (mask-mean)*tm\n    num = ndimage.convolve(mask, tm[::-1,::-1], mode='same')\n    num = num - s0 * tm.mean()\n    denom = std * np.sqrt((tm**2).sum())\n    corr = num / np.maximum(denom,1e-9)\n    return corr\n\ndef peaks(corr, thr, mindist=6):\n    cf = ndimage.maximum_filter(corr, size=mindist)\n    pk = (corr==cf) & (corr>=thr)\n    ys,xs = np.where(pk)\n    vals = corr[ys,xs]\n    idx = np.argsort(vals)[::-1]\n    out=[]\n","exit_code":0,"status":"completed"}}
