{"type":"item.started","item":{"id":"item_558","type":"command_execution","command":"/usr/bin/zsh -lc \"python3 - <<'EOF'\nimport numpy as np\nfrom PIL import Image\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nR,G,B=A[:,:,0],A[:,:,1],A[:,:,2]\nblack=(R<150)&(G<150)&(B<150)\n\ndef stats(cx,cy,half=6):\n    cx=int(round(cx)); cy=int(round(cy))\n    win=black[cy-half:cy+half+1, cx-half:cx+half+1]\n    ys,xs=np.where(win)\n    if len(xs)==0: return None\n    H=ys.max()-ys.min()+1; W=xs.max()-xs.min()+1\n    fill=win.sum()/(H*W)\n    c3=win[6:9,6:9].mean() if win.shape[0]>=9 else win.mean()\n    # width profile rows\n    prof=[int(win[r].sum()) for r in range(win.shape[0])]\n    topw=max(win[ys.min():ys.min()+2].sum(axis=1)) if len(ys) else 0\n    # bottom width\n    botw=max(win[ys.max()-1:ys.max()+1].sum(axis=1)) if len(ys) else 0\n    # middle width\n    midw=win[(ys.min()+ys.max())//2].sum()\n    return dict(H=H,W=W,fill=round(fill,2),c3=round(float(c3),2),topw=topw,botw=botw,midw=midw,prof=prof)\n\nfor name,x,y in [('open_circle',91,63.5),('filled_circle',91,80.8),('open_star',91,98.2),('filled_star',91,115.6)]:\n    s=stats(x,y)\n    print(name, s)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
