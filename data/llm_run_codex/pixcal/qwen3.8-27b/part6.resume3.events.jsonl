i = x0-6, x0+7\n    strip = black[14:229, xlo:xhi]\n    # remove legend\n    sl = np.zeros_like(strip); \n    for yy in range(strip.shape[0]):\n        if in_legend(xlo+np.arange(strip.shape[1]).mean(), yy+14):\n            sl[yy,:] = False\n    ys = np.where(strip.any(axis=1))[0]\n    groups=[]\n    if len(ys):\n        cur=[ys[0]]\n        for v in ys[1:]:\n            if v-cur[-1] <= 2: cur.append(v)\n            else: groups.append(cur); cur=[v]\n        groups.append(cur)\n    line=[]\n    for g in groups:\n        y0,y1 = g[0]+14, g[-1]+14\n        sub = black[y0:y1+1, xlo:xhi]\n        n = int(sub.sum())\n        if n < 5: continue\n        # hole check within this cluster: fill holes\n        filled = ndimage.binary_fill_holes(sub)\n        hole = int(filled.sum()-sub.sum())\n        h_ = y1-y0+1; w_ = xhi-xlo\n        yy,xx = np.where(sub)\n        cy = yy.mean()+y0\n        cx = xx.mean()+xlo\n        # local tight bbox\n        hh = yy.max()-yy.min()+1; ww = xx.max()-xx.min()+1\n        fill = n/(hh*ww)\n        line.append(f'y={cy:.1f} n={n} bbox={ww}x{hh} hole={hole} fill={fill:.2f}')\n    print(f'col x={x0}: ' + ' | '.join(line))\n","exit_code":0,"status":"completed"}}
