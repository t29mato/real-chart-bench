{"type":"item.completed","item":{"id":"item_840","type":"command_execution","command":"/usr/bin/zsh -lc 'ls -t *.py | head -30; echo ---; cat zz93_score2.py zz93_score.py 2>/dev/null'","aggregated_output":"zz93_score2.py\nzz93_score.py\nzz93_ascii.py\nzz93_holes2.py\nzz93_holes.py\nzz93_extract.py\nzz_redblue.py\nzz_f93_v2.py\nzz_f93_det.py\nzz_f93_extract.py\nzz_cols.py\nzz_ascii.py\nzz_opn.py\nzz_cls.py\nf93_scan.py\nzz_ascii5.py\nzz_ascii4.py\nzz_ascii3.py\nzz_ascii2.py\nzz_clean.py\nzz_pipe.py\nzz_clf.py\nzz_classify.py\nzz_black2.py\nzz_black.py\nzz_detect.py\nzz_f93_leg.py\nzz_f93_e.py\nzz_f93_d.py\nzz_f93_c.py\n---\nimport numpy as np\nfrom PIL import Image\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\nwhite  = (r>160)&(g>160)&(b>160).astype(bool)\nwhite  = white & (g>160) & (b>160)\ndark   = ~white\nH,W = a.shape[:2]\n\nR = 6\nyy,xx = np.mgrid[-R:R+1,-R:R+1]\nd = np.sqrt(xx*xx+yy*yy)\nM = {\n 'c15':  d<1.5,\n 'c22':  d<2.2,\n 'r245': (d>=2.4)&(d<=4.6),\n 'r36':  (d>=3.0)&(d<=6.0),\n 'd32':  d<3.2,\n 'a26':  (d>=2.5)&(d<=6.5),\n}\n\ndef feats(cx,cy):\n    Pw = white[cy-R:cy+R+1, cx-R:cx+R+1]\n    Pd = dark[cy-R:cy+R+1, cx-R:cx+R+1]\n    f = {}\n    for k,mk in M.items():\n        f[k] = Pw[mk].mean() if k in ('c15','c22') else Pd[mk].mean()\n    return f\n\ndef scores(f):\n    oc = (f['r245']*0.9 + f['c22']*0.3) if (f['c22']>=0.45 and f['d32']<0.75) else -1\n    ost= (f['r36']*0.7 + f['r245']*0.3 + f['c15']*0.3) if (f['c15']>=0.4 and f['d32']<0.8) else -1\n    fil= f['d32']\n    return oc,ost,fil\n\ngridx = [100.8 + k*(326.85-100.8)/16 for k in range(17)]\ngridT = [300+25*k for k in range(17)]\ndef px2y(py): return (py-222.7)*(1.4)/(19.95-222.7)\n\nfor cx,T in zip(gridx,gridT):\n    cx=int(round(cx))\n    cands=[]\n    for cy in range(22,226):\n        f = feats(cx,cy)\n        oc,ost,fil = scores(f)\n        cands.append((max(oc,ost,fil*0.9), cy, f['c22'], f['r245'], f['r36'], f['d32']))\n    # local maxima\n    cands.sort(key=lambda z:-z[0])\n    top = cands[:14]\n    print(f\"T={T}: \" + \" | \".join(f\"y={cy} w{c22:.2f} r{r245:.2f} s{r36:.2f} d{d32:.2f}\" for _,cy,c22,r245,r36,d32 in top))\nimport numpy as np\nfrom PIL import Image\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\nwhite  = (r>160)&(g>160)&(b>160)\ndark   = ~white   # anything non-white (black/red/blue/gray)\nH,W,_ = a.shape\n\n# precompute per-pixel for fast annulus sums\nyy,xx = np.mgrid[0:H,0:W]\n\ndef frac(mask, cx, cy, r0, r1):\n    d2 = (xx-cx)**2 + (yy-cy)**2\n    sel = (d2 >= r0*r0) & (d2 <= r1*r1)\n    return mask[sel].mean() if sel.sum()>0 else 0.0\n\ndef profiles(cx, cy):\n    # returns dict of features\n    c_white15 = frac(white, cx, cy, 0, 1.5)\n    c_white2  = frac(white, cx, cy, 0, 2.2)\n    ring245   = frac(dark,  cx, cy, 2.4, 4.6)\n    ring36    = frac(dark,  cx, cy, 3.0, 6.0)\n    disk3     = frac(dark,  cx, cy, 0, 3.2)\n    ann_25_6  = frac(dark,  cx, cy, 2.5, 6.5)\n    return c_white15,c_white2,ring245,ring36,disk3,ann_25_6\n\ndef open_circle_score(cx,cy):\n    c1,c2,ring,_,disk,_ = profiles(cx,cy)\n    if c2 < 0.45: return -1\n    if disk > 0.75: return -1   # filled center\n    s = ring*0.9 + c2*0.3\n    return s\n\ndef open_star_score(cx,cy):\n    c1,c2,ring,ring36,disk,_ = profiles(cx,cy)\n    if c1 < 0.4: return -1\n    if disk > 0.8: return -1\n    s = (ring36*0.7 + ring*0.3) + c1*0.3\n    return s\n\ndef filled_score(cx,cy):\n    _,_,_,_,disk,_ = profiles(cx,cy)\n    return disk\n\ngridx = [100.8 + k*(326.85-100.8)/16 for k in range(17)]\ngridT = [300+25*k for k in range(17)]\n\nfor cx,T in zip(gridx,gridT):\n    if T>650 and True:\n        pass\n    best=[]\n    for cyi in range(40, 452):\n        cy = 20 + cyi*0.5\n        oc = open_circle_score(cx,cy)\n        os_ = open_star_score(cx,cy)\n        fs = filled_score(cx,cy)\n        if oc>0: best.append((oc,'OC',cy))\n        if os_>0: best.append((os_,'OS',cy))\n        if fs>0.55: best.append((fs,'FC/FS',cy))\n    best.sort(reverse=True)\n    print(f\"T={T} px={cx:.1f}: \" + \"  \".join(f\"{n}:{v:.2f}@y{cy:.1f}\" for v,n,cy in best[:12]))\n","exit_code":0,"status":"completed"}}
