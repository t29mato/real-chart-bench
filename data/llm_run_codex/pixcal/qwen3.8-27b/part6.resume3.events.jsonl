{"type":"item.started","item":{"id":"item_996","type":"command_execution","command":"/usr/bin/zsh -lc \"cat > zz93_classify.py <<'EOF'\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\nim = Image.open('images/fig_093.png').convert('RGB')\na = np.array(im).astype(int)\nH,W = a.shape[:2]\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\ndark  = (r<120)&(g<120)&(b<120)          # black ink (incl. lines, text)\nred   = (r>140)&(g<110)&(b<110)\nblue  = (b>140)&(r<110)&(g<110)\nwhite = (r>160)&(g>160)&(b>160)\n\n# Find frame lines: long runs of dark\ncolsum = dark.sum(axis=0); rowsum = dark.sum(axis=1)\nframe_cols = [x for x in range(W) if colsum[x] > 150]\nframe_rows = [y for y in range(H) if rowsum[y] > 200]\nprint('frame cols', frame_cols)\nprint('frame rows', frame_rows)\n\n# Legend markers: search dark/red/blue blobs in top-left region x<140, y in 10..110\ndef blobs(mask, reg):\n    y0,y1,x0,x1 = reg\n    m = np.zeros_like(mask); m[y0:y1,x0:x1]=mask[y0:y1,x0:x1]\n    lab,n = ndimage.label(m)\n    out=[]\n    for i in range(1,n+1):\n        ys,xs=np.where(lab==i)\n        if len(ys)<8: continue\n        out.append((xs.mean(),ys.mean(),len(ys)))\n    return out\n\nfor name,mask in [('red',red),('blue',blue),('dark',dark)]:\n    print(name, [(round(x,1),round(y,1),n) for x,y,n in blobs(mask,(8,115,75,150))])\nEOF\npython3 zz93_classify.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
