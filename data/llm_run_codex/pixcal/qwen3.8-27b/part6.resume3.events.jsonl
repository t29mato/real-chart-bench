{"type":"item.started","item":{"id":"item_573","type":"command_execution","command":"/usr/bin/zsh -lc \"python3 - <<'EOF'\nimport numpy as np\nfrom PIL import Image\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nR,G,B=A[:,:,0],A[:,:,1],A[:,:,2]\nred=(R>140)&(G<110)&(B<110)\nblue=(B>120)&(R<110)&(G<110)\n# plot area only\ndef inplot(m):\n    m2=m.copy()\n    m2[:23,:]=False; m2[229:,:]=False; m2[:,:75]=False; m2[:,354:]=False\n    m2[20:130, 70:220]=False  # legend\n    return m2\nred=red & inplot(np.ones_like(red,bool))\nblue=blue & inplot(np.ones_like(blue,bool))\n\n# x calibration\npx_per_K=(326.85-100.8)/400.0\nT=np.arange(300,701,25)\nXG=100.8+(T-300)*px_per_K\n\ndef y_at(mask, xc, half=4):\n    a=int(round(xc))\n    sub=mask[:, max(0,a-half):a+half+1]\n    ys,xs=np.where(sub)\n    if len(ys)==0: return None,0\n    return float(np.median(ys)), len(ys)\n\nprint('RED :', )\nfor t,xc in zip(T,XG):\n    y,n=y_at(red,xc)\n    print(f'  T={t} x={xc:.1f} y={y} n={n}')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
