{"type":"item.started","item":{"id":"item_588","type":"command_execution","command":"/usr/bin/zsh -lc \"python3 - <<'EOF'\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nblack=(A[:,:,0]<150)&(A[:,:,1]<150)&(A[:,:,2]<150)\nblk=black.copy()\nblk[:22,:]=False; blk[229:,:]=False; blk[:,:75]=False; blk[:,353:]=False\nblk[20:130, 70:218]=False\n\ndef density(h=2):\n    d=np.zeros_like(blk,float)\n    for dy in range(-h,h+1):\n        for dx in range(-h,h+1):\n            d+=np.roll(np.roll(blk,dy,axis=0),dx,axis=1)\n    return d\nd=density(2)\nmx=ndimage.maximum_filter(d,size=5)\npeaks=(d==mx)&(d>=18)\nys,xs=np.where(peaks)\npts=[(float(x),float(y),float(d[y,x])) for x,y in zip(xs,ys)]\n# cluster within 4px\nused=[False]*len(pts)\nclusters=[]\nfor i,p in enumerate(pts):\n    if used[i]: continue\n    group=[i]; used[i]=True\n    changed=True\n    while changed:\n        changed=False\n        for j in range(len(pts)):\n            if used[j]: continue\n            if any(abs(pts[j][0]-pts[k][0])<=4 and abs(pts[j][1]-pts[k][1])<=4 for k in group):\n                group.append(j); used[j]=True; changed=True\n    clusters.append(group)\n\nmarkers=[]\nfor g in clusters:\n    arr=np.array([pts[i] for i in g])\n    w=arr[:,2]\n    cx=(arr[:,0]*w).sum()/w.sum()\n    cy=(arr[:,1]*w).sum()/w.sum()\n    markers.append((cx,cy,float(w.max())))\nmarkers.sort()\nprint('markers:',len(markers))\nfor x,y,dd in markers:\n    print(f'  x={x:6.1f} y={y:6.1f} dmax={dd:.0f}')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
