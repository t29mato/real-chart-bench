cy,cxp,dark)\n        if not s: continue\n        # filled circle if fr>0.55 and h<=8, else filled star\n        if s['fr'] > 0.55 and s['h'] <= 8 and s['n'] >= 35:\n            series['fillcirc'].append([T, round(px2y(cy),4)])\n        else:\n            series['fillstar'].append([T, round(px2y(cy),4)])\n    # classify each hole\n    for cy,cxp in holes:\n        s = shape(cy,cxp,dark)\n        hf = hole(cy,cxp)\n        if s and s['h'] >= 8:   # star ring is taller\n            series['openstar'].append([T, round(px2y(cy),4)])\n        else:\n            series['opencirc'].append([T, round(px2y(cy),4)])\n\nfor name,pts in series.items():\n    pts.sort()\n    print(name, len(pts), pts)\njson.dump({k:v for k,v in series.items()}, open('zz93_pts.json','w'), indent=1)\nimport numpy as np, json\nfrom PIL import Image\nfrom scipy import ndimage\n\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\ndark  = (r<120)&(g<120)&(b<120)\nred   = (r>140)&(g<110)&(b<110)\nblue  = (b>140)&(r<110)&(g<110)\nwhite = (r>160)&(g>160)&(b>160)\n\n# clear legend region from all masks\nfor m in (dark,red,blue,white):\n    m[13:131, 83:171] = False\nm0 = dark.copy(); m0[:21,:]=False; m0[230:,:]=False; m0[:,:73]=False; m0[:,355:]=False\ndark = m0\n\ny0,y1 = 21,229\ndef px2y(py): return (222.7-py)*1.4/202.75\ndef px2x(px): return 300 + (px-100.8)*400/(326.85-100.8)\n\ndef win(cy,cx, mask, half=5):\n    yy0,yy1 = int(cy-half)+1, int(cy+half)+1\n    xx0,xx1 = int(cx-half)+1, int(cx+half)+1\n    w_ = mask[yy0:yy1, xx0:xx1]\n    n = int(w_.sum())\n    if n < 4: return None\n    ys,xs = np.where(w_)\n    h=int(ys.max()-ys.min()+1); wd=int(xs.max()-xs.min()+1)\n    return dict(n=n,h=h,w=wd,fr=n/(h*wd))\n\ndef holef(cy,cx, half=5):\n    yy0,yy1 = int(cy-half)+1, int(cy+half)+1\n    xx0,xx1 = int(cx-half)+1, int(cx+half)+1\n    sub = white[yy0:yy1, xx0:xx1]\n    lab,n = ndimage.label(sub)\n    edge = set(lab[0,:].tolist())|set(lab[-1,:].tolist())|set(lab[:,0].tolist())|set(lab[:,-1].tolist())\n    for i in range(1,n+1):\n        if i in edge: continue\n        m = lab==i; ar=int(m.sum())\n        if ar >= 3:\n            ys,xs = np.where(m)\n            return dict(area=ar,h=int(ys.max()-ys.min()+1),w=int(xs.max()-xs.min()+1))\n    return None\n\n# legend calibration (on original masks, before clearing? recompute from raw)\nar = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nrd_ = (ar[:,:,0]>140)&(ar[:,:,1]<110)&(ar[:,:,2]<110)\nbl_ = (ar[:,:,2]>140)&(ar[:,:,0]<110)&(ar[:,:,1]<110)\ndk_ = (ar[:,:,0]<120)&(ar[:,:,1]<120)&(ar[:,:,2]<120)\nprint('LEGEND (win fr / core after erosion):')\nfor name,cx,cy,mask in [('redcirc',91,29,rd_),('bluestar',91,46,bl_),\n                        ('opencirc',91,62,dk_),('fillcirc',91,81,dk_),\n                        ('openstar',91,98,dk_),('fillstar',91,114,dk_)]:\n    w_ = mask[cy-6:cy+6, cx-6:cx+6]\n    core = ndimage.binary_erosion(w_, np.ones((3,3))).sum()\n    ys,xs=np.where(w_); h=ys.max()-ys.min()+1\n    print(f'  {name:9s} n={int(w_.sum()):3d} h={h} fr={w_.sum()/(h*(xs.max()-xs.min()+1)):.2f} core={int(core)}')\n\ncols = [100.8 + k*(326.85-100.8)/16 for k in range(17)]\nfor cx in cols:\n    T = round(px2x(cx))\n    out = [f'T={T}']\n    strip_r = red[y0:y1, int(cx-5):int(cx+6)]\n    if strip_r.sum() >= 5:\n        ys,xs = np.where(strip_r); out.append(f'RED {px2y(y0+ys.mean()):.3f}')\n    strip_b = blue[y0:y1, int(cx-5):int(cx+6)]\n    if strip_b.sum() >= 5:\n        ys,xs = np.where(strip_b); out.append(f'BLU {px2y(y0+ys.mean()):.3f}')\n    # black candidates\n    B = dark[y0:y1, int(cx-6):int(cx+7)]\n    er = ndimage.binary_erosion(B, np.ones((3,3)))\n    lab,n = ndimage.label(er)\n    cands=[]\n    for i in range(1,n+1):\n        m = lab==i\n        if m.sum() < 2: continue\n        ys,xs = np.where(m)\n        cands.append([y0+ys.mean(), int(cx-6)+xs.mean(), int(m.sum())])\n    Ws = white[y0:y1, int(cx-6):int(cx+7)]\n    labw,nw = ndimage.label(Ws)\n    edge = set(labw[0,:].tolist())|set(labw[-1,:].tolist())|set(labw[:,0].tolist())|set(labw[:,-1].tolist())\n    for i in range(1,nw+1):\n        if i in edge: continue\n        m = labw==i; ar=int(m.sum())\n        if 3 <= ar <= 50:\n            ys,xs = np.where(m)\n            cy = y0+ys.mean(); cxp = int(cx-6)+xs.mean()\n            # check no core at this location (it's an open marker)\n            near = [c for c in cands if abs(c[0]-cy)<4 and abs(c[1]-cxp)<4]\n            cands.append([cy,cxp,-ar])\n    cands = sorted(set((round(c[0],1),round(c[1],1),c[2]) for c in cands))\n    for cy,cxp,cn in cands:\n        w = win(cy,cxp,dark)\n        hf = holef(cy,cxp)\n        kind = '?'\n        if hf:\n            kind = 'O' + ('S' if (w and w['h']>=8) else 'C')\n        else:\n            kind = 'F' + ('C' if (w and w['fr']>=0.55) else 'S')\n        out.append(f'{kind}@{px2y(cy):.3f}(cy={cy:.1f},core={cn if cn>0 else \"-\"}'\n                   f'{\"\" if not w else f\",fr={w[chr(102)+chr(114)]:.2f},h={w[chr(104)]}\"}'\n                   f'{\",hole=\"+str(hf[\"area\"]) if hf else \"\"})')\n    print(' '.join(out))\n","exit_code":0,"status":"completed"}}
