{"type":"item.started","item":{"id":"item_1135","type":"command_execution","command":"/usr/bin/zsh -lc \"cat > zz93_tmpl.py <<'EOF'\nimport numpy as np\nfrom PIL import Image\n\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nlum = a.min(axis=2).astype(float)\ndark = 255.0 - lum   # darkness image\nblack = (a.min(axis=2) < 130)\n\ndef get_tmpl(y0,y1,x0=87,x1=96):\n    t = black[y0:y1, x0:x1].astype(float)\n    return t\n\nTM = {\n 'fillcirc': get_tmpl(78,84),\n 'opencirc': get_tmpl(61,67),\n 'openstar': get_tmpl(94,102),\n 'fillstar': get_tmpl(111,120),\n}\nfor k,t in TM.items():\n    print(k, t.shape, 'fg=', int(t.sum()))\n\ndef match(t, cy, cx, rad=5):\n    h,w = t.shape\n    best = (-1e9, None, None)\n    for dy in np.arange(-rad, rad+0.25, 0.5):\n        for dx in np.arange(-rad, rad+0.25, 0.5):\n            yy, xx = int(round(cy-dy-h/2)), int(round(cx-dx-w/2))\n            if yy<0 or xx<0 or yy+h>dark.shape[0] or xx+w>dark.shape[1]: continue\n            patch = dark[yy:yy+h, xx:xx+w]\n            fg = t.sum(); \n            if fg==0: continue\n            s = (patch*t).sum()/fg - patch.sum()/(h*w)\n            if s>best[0]: best=(s,yy,xx)\n    s,yy,xx = best\n    return s, yy+h/2, xx+w/2\n\ndef py2y(py): return (222.7-py)*1.4/202.75\n\nprint('\\\\n--- separated region check (known positions) ---')\ntests = [\n ('fillcirc', 140.4, 269.7), ('openstar', 131.2, 269.7), ('opencirc', 107.8, 269.7),\n ('fillcirc', 133.4, 283.8), ('openstar', 120.8, 283.8), ('opencirc', 99.5, 283.8),\n ('fillcirc', 125.3, 297.9), ('openstar', 108.2, 297.9), ('opencirc', 97.1, 297.9),\n ('openstar', 95.8, 312.0), ('openstar', 82.3, 326.9),\n ('fillstar', 181.8, 269.7), ('fillstar', 155.6, 326.9),\n]\nfor name, cy, cx in tests:\n    s, fy, fx = match(TM[name], cy, cx)\n    print(f'{name:9s} expect=({cy},{cx}) best=({fy:.1f},{fx:.1f}) score={s:.1f}')\nEOF\npython3 zz93_tmpl.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
