{"type":"item.started","item":{"id":"item_570","type":"command_execution","command":"/usr/bin/zsh -lc \"python3 - <<'EOF'\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nblack=(A[:,:,0]<150)&(A[:,:,1]<150)&(A[:,:,2]<150)\n\n# legend marker centers (x~91)\nfor name,y in [('open_circle',63.5),('filled_circle',80.8),('open_star',98.2),('filled_star',115.6)]:\n    cy=int(round(y)); cx=91\n    win=black[cy-6:cy+7, cx-6:cx+7]  # 13x13\n    # find connected component touching the center column (x=6)\n    col=win[:,6]\n    ys=np.where(col)[0]\n    if len(ys)==0:\n        print(name,'no center col'); continue\n    seed=ys[len(ys)//2]\n    lab,n=ndimage.label(win)\n    cid=lab[seed,6]\n    comp=(lab==cid)\n    # trim to bounding box of comp\n    ys2,xs2=np.where(comp)\n    y0,y1=ys2.min(),ys2.max(); x0,x1=xs2.min(),xs2.max()\n    core=comp[y0:y1+1,x0:x1+1]\n    print(f'{name}: core {core.shape[1]}x{core.shape[0]} npix={comp.sum()}')\n    for r in core:\n        print('   ',''.join('#' if v else '.' for v in r))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
