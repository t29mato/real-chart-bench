{"type":"item.completed","item":{"id":"item_1154","type":"command_execution","command":"/usr/bin/zsh -lc 'cat zz93_prof.py zz93_split.py 2>/dev/null'","aggregated_output":"import numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\nred  = (r>140)&(g<110)&(b<110)\nblue = (b>140)&(r<110)&(g<110)\nblack = (r<130)&(g<130)&(b<130)\nwhite = (r>170)&(g>170)&(b>170)\n\n# legend exclusion: x<=100 & y<=130 ; frame margins\nblack2 = black.copy()\nblack2[:21,:]=False; black2[230:,:]=False; black2[:,:74]=False; black2[:,355:]=False\nblack2[21:131, 74:101] = False\n\ndef px2x(px): return 300 + (px-100.8)*400/226.05\ndef py2y(py): return (222.7-py)*1.4/202.75\n\ncols = [round(100.8+(T-300)*226.05/400) for T in range(300,701,25)]\n\ndef runs(mask, x0, x1, y0=21, y1=229):\n    strip = mask[y0:y1, x0:x1]\n    colprof = strip.any(axis=1)\n    out=[]; y=0\n    while y < len(colprof):\n        if colprof[y]:\n            y2=y\n            while y2+1<len(colprof) and colprof[y2+1]: y2+=1\n            out.append((y0+y, y0+y2))\n            y=y2+1\n        else: y+=1\n    return out\n\nfor T,cx in zip(range(300,701,25), cols):\n    x0,x1 = cx-4, cx+5\n    line=[f'T={T} cx={cx}']\n    for name,mask in [('R',red),('B',blue)]:\n        for (a_,b_) in runs(mask,x0,x1):\n            if b_-a_+1>=3:\n                # centroid in window\n                ys,xs = np.where(mask[a_:b_+1, x0:x1])\n                cy = a_+ys.mean()\n                line.append(f'{name} y={cy:.1f}({py2y(cy):.3f}) h={b_-a_+1} n={len(ys)}')\n    # black blobs: label within window\n    sub = black2[21:229, x0:x1]\n    lab,n = ndimage.label(sub)\n    for i in range(1,n+1):\n        m = lab==i\n        if m.sum()<8: continue\n        ys,xs = np.where(m)\n        cy = 21+ys.mean(); cxp = x0+xs.mean()\n        h = ys.max()-ys.min()+1; w = xs.max()-xs.min()+1\n        # hole check in window around blob\n        yy0,yy1 = max(0,int(ys.min())-2), min(sub.shape[0], int(ys.max())+3)\n        xx0,xx1 = max(0,int(xs.min())-2), min(sub.shape[1], int(xs.max())+3)\n        hole_area = 0\n        Wsub = white[21+yy0:21+yy1, x0+xx0:x0+xx1]\n        if Wsub.any():\n            lw,nw = ndimage.label(Wsub)\n            edge = set(lw[0,:].tolist())|set(lw[-1,:].tolist())|set(lw[:,0].tolist())|set(lw[:,-1].tolist())\n            for j in range(1,nw+1):\n                if j in edge: continue\n                hole_area += int((lw==j).sum())\n        line.append(f'K cy={cy:.1f}(zT={py2y(cy):.3f}) h={h} w={w} n={int(m.sum())} fr={m.sum()/(h*w):.2f} hole={hole_area}')\n    print(' '.join(line))\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nblack = (a.min(axis=2) < 130)\ndef py2y(py): return (222.7-py)*1.4/202.75\n\nblobs = [(300,207.0),(325,203.4),(350,199.2),(375,194.9),(400,189.8),\n         (425,184.6),(450,178.8),(475,172.6),(500,166.1),(525,158.7),\n         (550,151.6),(575,143.7)]\nprint('T    | blob-cy   core-cy  ring-cy | dzT(core)  dzT(ring)')\nfor T,cy in blobs:\n    cx = 100.8+(T-300)*0.565125\n    x0,x1 = int(cx-4), int(cx+5)\n    y0,y1 = int(cy-6), int(cy+7)\n    sub = black[y0:y1, x0:x1]\n    er = sub\n    for _ in range(2): er = ndimage.binary_erosion(er, np.ones((3,3)))\n    if not er.any():\n        print(T,'no core'); continue\n    ys,xs = np.where(er)\n    core_cy = y0+ys.mean(); core_cx = x0+xs.mean()\n    # ring = sub pixels more than 2.5 from core\n    yy,xx = np.mgrid[0:sub.shape[0],0:sub.shape[1]]\n    dist = np.sqrt((yy-(core_cy-y0))**2 + (xx-(core_cx-x0))**2)\n    ring = sub & (dist>2.3)\n    ry,rx = np.where(ring)\n    ring_cy = y0+ry.mean() if len(ry) else float('nan')\n    print(f'{T:4d} | {cy:7.1f} {core_cy:8.1f} {ring_cy:8.1f} | {py2y(core_cy):.3f}  {py2y(ring_cy):.3f}  (core_n={int(er.sum())}, ring_n={int(ring.sum())})')\n","exit_code":0,"status":"completed"}}
