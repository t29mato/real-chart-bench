{"type":"item.started","item":{"id":"item_1003","type":"command_execution","command":"/usr/bin/zsh -lc \"cat > zz93_final.py <<'EOF'\nimport numpy as np, json\nfrom PIL import Image\nfrom scipy import ndimage\n\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nH,W = a.shape[:2]\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\ndark  = (r<120)&(g<120)&(b<120)\nred   = (r>140)&(g<110)&(b<110)\nblue  = (b>140)&(r<110)&(g<110)\nwhite = (r>160)&(g>160)&(b>160)\n\ny0,y1 = 21,229\ndef px2y(py): return (222.7-py)*1.4/202.75\ndef px2x(px): return 300 + (px-100.8)*400/(326.85-100.8)\n\ndef shape(cy,cx, mask, half=5):\n    yy0,yy1 = int(cy-half)+1, int(cy+half)+1\n    xx0,xx1 = int(cx-half)+1, int(cx+half)+1\n    win = mask[yy0:yy1, xx0:xx1]\n    n = int(win.sum())\n    if n < 4: return None\n    ys,xs = np.where(win)\n    h=int(ys.max()-ys.min()+1); w=int(xs.max()-xs.min()+1)\n    return dict(n=n,h=h,w=w,fr=n/(h*w),ar=w/h)\n\ndef hole(cy,cx, half=5):\n    yy0,yy1 = int(cy-half)+1, int(cy+half)+1\n    xx0,xx1 = int(cx-half)+1, int(cx+half)+1\n    sub = white[yy0:yy1, xx0:xx1]\n    lab,n = ndimage.label(sub)\n    edge = set(lab[0,:].tolist())|set(lab[-1,:].tolist())|set(lab[:,0].tolist())|set(lab[:,-1].tolist())\n    for i in range(1,n+1):\n        if i in edge: continue\n        m = lab==i; area=int(m.sum())\n        if area >= 3:\n            ys,xs = np.where(m)\n            h=int(ys.max()-ys.min()+1); w=int(xs.max()-xs.min()+1)\n            return dict(area=area,h=h,w=w,fr=area/(h*w),ar=w/h)\n    return None\n\n# legend reference shapes\nprint('legend:')\nfor name,cx,cy,mask in [('redcirc',91,29,red),('bluestar',91,46,blue),\n                        ('opencirc',91,62,dark),('fillcirc',91,81,dark),\n                        ('openstar',91,98,dark),('fillstar',91,114,dark)]:\n    s = shape(cy,cx,mask); h = hole(cy,cx)\n    print(f'  {name:9s} {s}  hole={h}')\n\ncols = [100.8 + k*(326.85-100.8)/16 for k in range(17)]\nseries = {name: [] for name in ['red','blue','opencirc','fillcirc','openstar','fillstar']}\n\nfor cx in cols:\n    T = round(px2x(cx))\n    # red / blue centroids\n    for name,mask in [('red',red),('blue',blue)]:\n        strip = mask[y0:y1, int(cx-5):int(cx+6)]\n        if strip.sum() >= 5:\n            ys,xs = np.where(strip)\n            series[name].append([T, round(px2y(y0+ys.mean()),4)])\n        else:\n            print(f'T={T} MISSING {name}')\n\n    # black: filled cores\n    B = dark[y0:y1, int(cx-6):int(cx+7)]\n    er = ndimage.binary_erosion(B, np.ones((3,3)))\n    lab,n = ndimage.label(er)\n    cores=[]\n    for i in range(1,n+1):\n        m = lab==i\n        if m.sum() < 2: continue\n        ys,xs = np.where(m)\n        cores.append((y0+ys.mean(), int(cx-6)+xs.mean()))\n    # black: holes\n    Ws = white[y0:y1, int(cx-6):int(cx+7)]\n    labw,nw = ndimage.label(Ws)\n    edge = set(labw[0,:].tolist())|set(labw[-1,:].tolist())|set(labw[:,0].tolist())|set(labw[:,-1].tolist())\n    holes=[]\n    for i in range(1,nw+1):\n        if i in edge: continue\n        m = labw==i; area=int(m.sum())\n        if 3 <= area <= 50:\n            ys,xs = np.where(m)\n            holes.append((y0+ys.mean(), int(cx-6)+xs.mean()))\n    # classify each core\n    for cy,cxp in cores:\n        s = shape(cy,cxp,dark)\n        if not s: continue\n        # filled circle if fr>0.55 and h<=8, else filled star\n        if s['fr'] > 0.55 and s['h'] <= 8 and s['n'] >= 35:\n            series['fillcirc'].append([T, round(px2y(cy),4)])\n        else:\n            series['fillstar'].append([T, round(px2y(cy),4)])\n    # classify each hole\n    for cy,cxp in holes:\n        s = shape(cy,cxp,dark)\n        hf = hole(cy,cxp)\n        if s and s['h'] >= 8:   # star ring is taller\n            series['openstar'].append([T, round(px2y(cy),4)])\n        else:\n            series['opencirc'].append([T, round(px2y(cy),4)])\n\nfor name,pts in series.items():\n    pts.sort()\n    print(name, len(pts), pts)\njson.dump({k:v for k,v in series.items()}, open('zz93_pts.json','w'), indent=1)\nEOF\npython3 zz93_final.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
