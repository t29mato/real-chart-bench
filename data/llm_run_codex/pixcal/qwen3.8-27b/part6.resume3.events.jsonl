{"type":"item.started","item":{"id":"item_678","type":"command_execution","command":"/usr/bin/zsh -lc \"cd . && python3 - <<'EOF'\nimport numpy as np\nfrom PIL import Image\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nR,G,B=A[:,:,0],A[:,:,1],A[:,:,2]\nred=(R>150)&(G<110)&(B<110)\nblue=(B>150)&(R<110)&(G<110)\nblack=(R<150)&(G<150)&(B<150)\ndef ch(y,x):\n    if red[y,x]:return 'R'\n    if blue[y,x]:return 'B'\n    if black[y,x]:return '#'\n    return '.'\ndef show(cx,cy,h,label=''):\n    cx=int(round(cx)); cy=int(round(cy))\n    print(f'--- {label} ---')\n    for y in range(cy-h,cy+h+1):\n        print(''.join(ch(y,x) for x in range(cx-h,cx+h+1)))\n# T=600 x=270, 4 black at 106.5,130.5,140.5,181.5\nshow(270,106,6,'T600 black#1 y106')\nshow(270,130,6,'T600 black#2 y130')\nshow(270,140,6,'T600 black#3 y140')\nshow(270,181,7,'T600 black#4 y181')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
