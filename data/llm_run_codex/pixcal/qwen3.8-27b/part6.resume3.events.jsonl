{"type":"item.completed","item":{"id":"item_983","type":"command_execution","command":"/usr/bin/zsh -lc 'cat zz_f93_v2.py zz_f93_det.py zz_f93_extract.py zz_view93.py 2>/dev/null; ls -la zz_full8x.png zz_leg8x.png 2>/dev/null'","aggregated_output":"import numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\nred   = (r>140)&(g<110)&(b<110)\nblue  = (b>140)&(r<110)&(g<110)\nblack = (r<110)&(g<110)&(b<110)\nwhite = (r>170)&(g>170)&(b>170)\nfor m in (red,blue,black,white):\n    m[18:24,:]=False; m[226:234,:]=False\n    m[:,68:76]=False; m[:,352:360]=False\n    m[232:,:]=False; m[:16,:]=False\n    m[:140,:208]=False\n\ndef px2x(px): return 300 + (px-100.8)*(400)/(326.85-100.8)\ndef px2y(py): return 0.0 + (py-222.7)*(1.4)/(19.95-222.7)\n\ncols=[100,114,128,142,157,171,185,199,213,228,242,256,270,284,298,312,326]\n\ndef color_y(mask,cx):\n    sub=mask[30:225,cx-6:cx+7]\n    if sub.sum()<4: return None\n    ys,xs=np.where(sub); return 30+ys.mean()\n\ndef black_markers(cx):\n    x0,x1=cx-7,cx+8\n    y0,y1=30,225\n    B=black[y0:y1,x0:x1]\n    er=ndimage.binary_erosion(B,np.ones((3,3)))\n    lab,n=ndimage.label(er)\n    res=[]\n    for i in range(1,n+1):\n        m=(lab==i)\n        if m.sum()<2: continue\n        ys,xs=np.where(m)\n        cy=y0+ys.mean()\n        yw0,yw1=int(cy)-4,int(cy)+5\n        win=black[max(y0,yw0):min(y1,yw1), max(x0,xs.min()-1):min(x1,xs.max()+2)]\n        fr=win.sum()/max(1,win.size)\n        kind='FC' if fr>0.52 else 'FS'\n        res.append((cy,kind,fr))\n    Wl=white[y0:y1,x0:x1]\n    wl,nw=ndimage.label(Wl)\n    edge=set(wl[0,:].tolist())|set(wl[-1,:].tolist())|set(wl[:,0].tolist())|set(wl[:,-1].tolist())\n    for i in range(1,nw+1):\n        if i in edge: continue\n        m=(wl==i)\n        area=m.sum()\n        if area<4 or area>60: continue\n        ys,xs=np.where(m)\n        cy=y0+ys.mean()\n        h=ys.max()-ys.min()+1; w=xs.max()-xs.min()+1\n        fr=area/(h*w)\n        kind='OC' if fr>0.55 else 'OS'\n        res.append((cy,kind,fr))\n    return res\n\nfor cx in cols:\n    ry=color_y(red,cx); by=color_y(blue,cx)\n    mk=black_markers(cx)\n    print(f\"col {cx} (x={px2x(cx):.0f}) red={ry and round(px2y(ry),3)} blue={by and round(px2y(by),3)}\")\n    for cy,k,fr in sorted(mk):\n        print(f\"   {k}  cy={cy:.1f} ZT={px2y(cy):.3f} fr={fr:.2f}\")\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\nH,W = a.shape[:2]\nred   = (r>140)&(g<110)&(b<110)\nblue  = (b>140)&(r<110)&(g<110)\nblack = (r<110)&(g<110)&(b<110)\nwhite = (r>170)&(g>170)&(b>170)\nfor m in (red,blue,black,white):\n    m[18:24,:]=False; m[226:234,:]=False\n    m[:,68:76]=False; m[:,352:360]=False\n    m[232:,:]=False; m[:16,:]=False\n    m[:140,:208]=False\n\ndef px2x(px): return 300 + (px-100.8)*(400)/(326.85-100.8)\ndef px2y(py): return 0.0 + (py-222.7)*(1.4)/(19.95-222.7)\n\ncols=[100,114,128,142,157,171,185,199,213,228,242,256,270,284,298,312,326]\n\n# For each column, find red, blue marker y (centroid of that color in strip)\n# For black: find all black blobs in the strip via connected components of\n# (black dilated a bit to bridge marker), then classify each blob.\ndef find_black_blobs(cx):\n    x0,x1=cx-6,cx+7\n    sub = black[30:225, x0:x1]\n    # dilate vertically to connect marker core but not merge separate markers\n    lab,n = ndimage.label(sub)\n    out=[]\n    for i in range(1,n+1):\n        m=(lab==i)\n        area=m.sum()\n        if area<6: continue\n        ys,xs=np.where(m)\n        cy=30+ys.mean(); cxp=x0+xs.mean()\n        h=ys.max()-ys.min()+1; w=xs.max()-xs.min()+1\n        out.append((cy,cxp,area,h,w))\n    return out\n\nfor cx in cols:\n    rc=None;bc=None\n    sub_r=red[30:225,cx-6:cx+7]\n    if sub_r.sum()>4:\n        ys,xs=np.where(sub_r); rc=30+ys.mean()