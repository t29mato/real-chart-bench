{"type":"item.started","item":{"id":"item_547","type":"command_execution","command":"/usr/bin/zsh -lc \"python3 - <<'EOF'\nimport numpy as np\nfrom PIL import Image\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nR,G,B=A[:,:,0],A[:,:,1],A[:,:,2]\nblack=(R<150)&(G<150)&(B<150)\nblk=black.copy()\nblk[20:130, 70:218]=False   # legend\nblk[:22,:]=False; blk[229:,:]=False  # top/bottom frame\nblk[:,:75]=False; blk[:,353:]=False  # left/right frame\n\ndef density(win=7,thr=None):\n    d=np.zeros_like(black,float)\n    h=win//2\n    for dy in range(-h,h+1):\n        for dx in range(-h,h+1):\n            d+=np.roll(np.roll(black,dy,axis=0),dx,axis=1)\n    return d\n\nd7=density(7)\n# marker cores: filled circle ~ pi*3.5\"'^2/49*49 ≈ 38; open circle ring ≈ 30; star ≈ 30\n# line through 7x7: 7*2 = 14 max\ncand = d7>=25\nys,xs=np.where(cand)\npts=sorted(zip(xs,ys))\ngroups=[];cur=[pts[0]]\nfor p in pts[1:]:\n    if p[0]-cur[-1][0]<=4 and abs(p[1]-cur[-1][1])<=4: cur.append(p)\n    else: groups.append(cur);cur=[p]\ngroups.append(cur)\ndef classify(cx,cy):\n    cx=int(round(cx)); cy=int(round(cy))\n    win=blk[cy-5:cy+6, cx-5:cx+6]\n    c=win[5:7,5:7].mean()\n    # topmost row with >=1 px within window\n    ys2,xs2=np.where(win)\n    ytop=ys2.min()\n    topw=win[ytop:ytop+2].sum(axis=1).max()\n    h=ys2.max()-ytop+1; w=xs2.max()-xs2.min()+1\n    fill='\"'filled' if c>0.5 else 'open'\n    return fill, topw, h, w\n\nres=[]\nfor g in groups:\n    g=np.array(g)\n    cx,cy=g[:,0].mean(),g[:,1].mean()\n    f,tw,h,w=classify(cx,cy)\n    res.append((cx,cy,f,tw,h,w,len(g)))\nres.sort()\nprint('black marker candidates:',len(res))\nfor cx,cy,f,tw,h,w,n in res:\n    print(f'  x={cx:6.1f} y={cy:6.1f} {f:6s} topw={tw} h={h} w={w} n={n}')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
