n('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nR,G,B=A[:,:,0],A[:,:,1],A[:,:,2]\nblack=(R<150)&(G<150)&(B<150)\n# remove frame lines and legend. Keep interior x 76..353, y 22..229\nmask=black.copy()\nmask[:, :77]=False; mask[:,354:]=False\nmask[:23,:]=False; mask[228:,:]=False\n# Remove legend box region (top-left): find its extent\n# Legend markers at x~91; text to the right. Exclude x< 214 & y<126? but data at x<214 has high y.\n# Actually exclude legend by known box: x in [77,214], y in [22,126]\nmask[22:127,77:215]=False\n\n# erosion to get markers\ner=ndimage.binary_erosion(mask, iterations=1)\nlab,n=ndimage.label(er)\nblobs=[]\nfor i in range(1,n+1):\n    ys,xs=np.where(lab==i)\n    if len(xs)<3: continue\n    blobs.append((round(xs.mean(),1),round(ys.mean(),1),len(xs)))\nblobs.sort()\nprint('black blobs after erosion1:',len(blobs))\nfor x,y,s in blobs: print(f'  x={x} y={y} size={s}')\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nR,G,B=A[:,:,0],A[:,:,1],A[:,:,2]\nblack=(R<150)&(G<150)&(B<150)\nmask=black.copy()\nmask[:, :77]=False; mask[:,354:]=False\nmask[:23,:]=False; mask[228:,:]=False\nmask[22:127,77:215]=False  # legend\nT=np.arange(300,701,25)\nx0,x1=100.8,326.85\nXG=x0+(T-300)/400*(x1-x0)\n\n# For each column, get black pixel row histogram; find clusters (markers)\ndef clusters_at(xc, half=4):\n    a=int(round(xc)); lo=max(78,a-half); hi=min(354,a+half+1)\n    col=mask[23:228, lo:hi].sum(axis=1)\n    rows=np.where(col>=3)[0]+23\n    if len(rows)==0: return []\n    # group contiguous rows (gap<=3)\n    groups=[]; cur=[rows[0]]\n    for r in rows[1:]:\n        if r-cur[-1]<=3: cur.append(r)\n        else: groups.append(cur); cur=[r]\n    groups.append(cur)\n    out=[]\n    for g in groups:\n        g=np.array(g)\n        # weight by col count\n        w=col[g-23]\n        cy=(g*w).sum()/w.sum()\n        out.append((round(cy,1), len(g), int(col[g-23].max())))\n    return out\n\nprint('Column-by-column black marker clusters (cy, rowcount, maxwidth):')\nfor t,xc in zip(T,XG):\n    cl=clusters_at(xc)\n    print(f'T={t} x={xc:.1f}:', cl)\n","exit_code":0,"status":"completed"}}
