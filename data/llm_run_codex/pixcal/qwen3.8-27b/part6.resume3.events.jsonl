{"type":"item.started","item":{"id":"item_579","type":"command_execution","command":"/usr/bin/zsh -lc \"python3 - <<'EOF'\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nblack=(A[:,:,0]<150)&(A[:,:,1]<150)&(A[:,:,2]<150)\n\ndef analyze(cx,cy,half=6):\n    cx=int(round(cx)); cy=int(round(cy))\n    win=black[cy-half:cy+half+1, cx-half:cx+half+1]\n    ys,xs=np.where(win)\n    ytop=ys.min(); ybot=ys.max()\n    topw=int(win[ytop:ytop+2].sum(axis=1).max())\n    Wt=~win\n    border=np.zeros_like(Wt,bool); border[0,:]=True;border[-1,:]=True;border[:,0]=True;border[:,-1]=True\n    lab,n=ndimage.label(Wt)\n    bl=set(lab[border].tolist())-{0}\n    hole=sum(int((lab==i).sum()) for i in range(1,n+1) if i not in bl)\n    H=ybot-ytop+1\n    # interior white in central rows (rows around vertical middle)\n    mid=(ytop+ybot)//2\n    central_white=int(Wt[mid-1:mid+2, 4:10].sum())\n    return dict(topw=topw,hole=hole,H=H,central_white=central_white,npix=int(win.sum()))\n\nfor name,x,y in [('open_circle',91,63.5),('filled_circle',91,80.8),('open_star',91,98.2),('filled_star',91,115.6)]:\n    print(f'{name:15s}',analyze(x,y))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
