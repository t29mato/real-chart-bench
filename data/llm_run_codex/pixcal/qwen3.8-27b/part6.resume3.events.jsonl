{"type":"item.started","item":{"id":"item_1002","type":"command_execution","command":"/usr/bin/zsh -lc \"cat > zz93_extract2.py <<'EOF'\nimport numpy as np, json\nfrom PIL import Image\nfrom scipy import ndimage\n\na = np.array(Image.open('images/fig_093.png').convert('RGB')).astype(int)\nH,W = a.shape[:2]\nr,g,b = a[:,:,0],a[:,:,1],a[:,:,2]\ndark  = (r<120)&(g<120)&(b<120)\nred   = (r>140)&(g<110)&(b<110)\nblue  = (b>140)&(r<110)&(g<110)\nwhite = (r>160)&(g>160)&(b>160)\n\ny0,y1 = 21,229   # inside frame\nx0,x1 = 73,354\n\ndef px2x(px): return 300 + (px-100.8)*400/(326.85-100.8)\ndef px2y(py): return (222.7-py)*1.4/202.75\n\ndef features(mask, cy, cx, half=5):\n    yy0,yy1 = int(cy-half)+1, int(cy+half)+1\n    xx0,xx1 = int(cx-half)+1, int(cx+half)+1\n    win = mask[yy0:yy1, xx0:xx1]\n    n = win.sum()\n    if n==0: return None\n    ys,xs = np.where(win)\n    h = ys.max()-ys.min()+1; w = xs.max()-xs.min()+1\n    return dict(n=int(n), h=int(h), w=int(w), fr=n/(h*w), aspect=w/h)\n\ndef hole_features(cy,cx, half=5):\n    yy0,yy1 = int(cy-half)+1, int(cy+half)+1\n    xx0,xx1 = int(cx-half)+1, int(cx+half)+1\n    sub = white[yy0:yy1, xx0:xx1]\n    lab,n = ndimage.label(sub)\n    edge = set(lab[0,:].tolist())|set(lab[-1,:].tolist())|set(lab[:,0].tolist())|set(lab[:,-1].tolist())\n    best=None\n    for i in range(1,n+1):\n        if i in edge: continue\n        m = lab==i; area=int(m.sum())\n        if area < 3: continue\n        ys,xs = np.where(m)\n        h=ys.max()-ys.min()+1; w=xs.max()-xs.min()+1\n        cyh = yy0+ys.mean(); cxh = xx0+xs.mean()\n        f = dict(area=area,h=h,w=w,fr=area/(h*w),aspect=w/h, dy=cyh-cy)\n        if best is None or abs(f['dy'])<abs(best['dy']): best=f\n    return best\n\n# --- legend calibration ---\nleg = [(91.1,28.7,'red circle'),(91.0,46.0,'blue star'),(91.1,62.5,'open circle'),\n       (91.1,80.8,'filled circle'),(91.1,98.0,'open star'),(91.1,113.7,'filled star')]\nprint('LEGEND FEATURES')\nfor cx,cy,name in leg:\n    if name=='red circle':  f=features(red,cy,cx);  h=None\n    elif name=='blue star': f=features(blue,cy,cx); h=None\n    else:\n        f = features(dark,cy,cx)\n        h = hole_features(cy,cx)\n    print(f'{name:14s} {f} hole={h}')\n\n# --- plot extraction ---\ncols = [round(100.8 + k*(326.85-100.8)/16) for k in range(17)]\ncols = [100.8 + k*(326.85-100.8)/16 for k in range(17)]\n\nresults = {}\nfor cx in cols:\n    T = px2x(cx)\n    strip_r = red[y0:y1, int(cx-5):int(cx+6)]\n    red_c = None\n    if strip_r.sum() >= 5:\n        ys,xs = np.where(strip_r); red_c = y0+ys.mean()\n    strip_b = blue[y0:y1, int(cx-5):int(cx+6)]\n    blue_c = None\n    if strip_b.sum() >= 5:\n        ys,xs = np.where(strip_b); blue_c = y0+ys.mean()\n\n    # black filled cores\n    B = dark[y0:y1, int(cx-6):int(cx+7)]\n    er = ndimage.binary_erosion(B, np.ones((3,3)))\n    lab,n = ndimage.label(er)\n    filled=[]\n    for i in range(1,n+1):\n        m = lab==i\n        if m.sum() < 2: continue\n        ys,xs = np.where(m)\n        cy = y0+ys.mean(); cxp = int(cx-6)+xs.mean()\n        filled.append((cy,cxp,m.sum()))\n    # black holes (open markers)\n    Ws = white[y0:y1, int(cx-6):int(cx+7)]\n    labw,nw = ndimage.label(Ws)\n    edge = set(labw[0,:].tolist())|set(labw[-1,:].tolist())|set(labw[:,0].tolist())|set(labw[:,-1].tolist())\n    holes=[]\n    for i in range(1,nw+1):\n        if i in edge: continue\n        m = labw==i; area=int(m.sum())\n        if area < 3 or area > 50: continue\n        ys,xs = np.where(m)\n        cy = y0+ys.mean(); cxp = int(cx-6)+xs.mean()\n        holes.append((cy,cxp,area))\n    print(f'--- T={T:.0f} (px {cx:.1f})  red_cy={red_c and round(red_c,1)} blue_cy={blue_c and round(blue_c,1)}')\n    for cy,cxp,nb in sorted(filled):\n        f = features(dark,cy,cxp)\n        print(f'  FILLED core n={nb} {f}')\n    for cy,cxp,area in sorted(holes):\n        hf = hole_features(cy,cxp)\n        print(f'  HOLE area={area} cy={cy:.1f} {hf}')\nEOF\npython3 zz93_extract2.py 2>&1 | head -120\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
