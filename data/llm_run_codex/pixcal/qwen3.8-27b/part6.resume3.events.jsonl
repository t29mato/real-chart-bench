{"type":"item.started","item":{"id":"item_576","type":"command_execution","command":"/usr/bin/zsh -lc \"python3 - <<'EOF'\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\nim=Image.open('images/fig_093.png').convert('RGB')\nA=np.asarray(im).astype(int)\nblack=(A[:,:,0]<150)&(A[:,:,1]<150)&(A[:,:,2]<150)\n\ndef classify(cx,cy,half=6):\n    cx=int(round(cx)); cy=int(round(cy))\n    win=black[cy-half:cy+half+1, cx-half:cx+half+1]\n    ys,xs=np.where(win)\n    if len(xs)<4: return None\n    ytop=ys.min()\n    topw=int(win[ytop:ytop+2].sum(axis=1).max())\n    # hole detection: white pixels not connected to window border\n    Wt=~win\n    # border seed\n    border=np.zeros_like(Wt,bool)\n    border[0,:]=True; border[-1,:]=True; border[:,0]=True; border[:,-1]=True\n    lab,n=ndimage.label(Wt)\n    # labels touching border\n    border_labels=set(lab[border].tolist())- {0}\n    hole=0\n    for i in range(1,n+1):\n        if i not in border_labels:\n            hole+=int((lab==i).sum())\n    shape='circle' if topw>=3 else 'star'\n    kind='open' if hole>=2 else 'filled'\n    return dict(shape=shape,kind=kind,topw=topw,hole=hole,n=int(win.sum()))\n\ntests=[('open_circle',91,63.5),('filled_circle',91,80.8),('open_star',91,98.2),('filled_star',91,115.6)]\nfor name,x,y in tests:\n    r=classify(x,y)\n    pred=(r['kind'] if r else None)+'_'+(r['shape'] if r else None)\n    print(f'{name:15s} -> {pred:15s} {r}  {\\\"OK\\\" if pred==name else \\\"MISMATCH\\\"}')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
