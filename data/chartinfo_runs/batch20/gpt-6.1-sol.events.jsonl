{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/zsh -lc \"cat > extract.py <<'PY'\nimport json\nfrom PIL import Image\nimport numpy as np\nfrom scipy.ndimage import label,find_objects\nP='predictions.json'\ndef save(fig,series):\n d=json.load(open(P));d[f'fig_{fig:02d}.png']=series;json.dump(d,open(P,'w'),indent=2)\ndef ser(name,pts,fx=lambda x:x,fy=lambda y:y):\n return {'name':name,'data':[{'x':round(float(fx(x)),7),'y':round(float(fy(y)),7)} for x,y in pts]}\ndef unnamed(i):return f'[unnamed data series #{i}]'\ndef components(fig,box,threshold=100):\n a=np.array(Image.open(f'images/fig_{fig:02d}.png').convert('RGB'));m=(a[:,:,:3].min(2)<threshold)\n x0,y0,x1,y1=box;m[:y0]=0;m[y1:]=0;m[:,:x0]=0;m[:,x1:]=0\n lab,n=label(m);out=[]\n for i,s in enumerate(find_objects(lab),1):\n  ys,xs=np.where(lab[s]==i);area=len(xs)\n  if area>=5:out.append((round(xs.mean()+s[1].start,2),round(ys.mean()+s[0].start,2),area,s[1].stop-s[1].start,s[0].stop-s[0].start))\n return out\nif __name__=='__main__':\n print(components(3,(80,43,725,428)))\nPY\npython extract.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
