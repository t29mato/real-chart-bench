{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/zsh -lc \"cat > extract.py <<'PY'\nimport json\nfrom pathlib import Path\nP=Path('predictions.json')\ndef save(k,series):\n p=json.loads(P.read_text());p[f'fig_{k:02}.png']=[{'name':n,'data':[{'x':round(x,5),'y':round(y,5)} for x,y in pts]} for n,pts in series];P.write_text(json.dumps(p,indent=2,ensure_ascii=False))\ndef unnamed(pts):return [('[unnamed data series #0]',pts)]\ndef coords(points,box,limits):\n l,r,t,b=box;x0,x1,y0,y1=limits\n return [(x0+(x-l)/(r-l)*(x1-x0),y1+(y-t)/(b-t)*(y0-y1)) for x,y in points]\nsave(1,unnamed([(0,4.85),(10,7.85),(20,9.05),(30,9.2),(40,9.35),(50,9.45),(60,9.5),(70,9.5)]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
