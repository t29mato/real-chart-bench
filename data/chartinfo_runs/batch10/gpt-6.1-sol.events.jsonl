{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/zsh -lc \"cat > extract.py <<'PY'\nimport json, math\nfrom pathlib import Path\nP=Path('predictions.json')\ndef save(i,series):\n d=json.loads(P.read_text()); d[f'fig_{i:02d}.png']=[{'name':n,'data':[{'x':round(x,7),'y':round(y,7)} for x,y in pts]} for n,pts in series]; P.write_text(json.dumps(d,indent=2))\ndef pix(i, axes, series, logx=False, logy=False):\n l,r,x0,x1,t,b,y1,y0=axes\n def cv(p,a,b,v,w,log):\n  if log: return 10**(math.log10(v)+(p-a)/(b-a)*(math.log10(w)-math.log10(v)))\n  return v+(p-a)/(b-a)*(w-v)\n save(i,[(n,[(cv(x,l,r,x0,x1,logx),cv(y,t,b,y1,y0,logy)) for x,y in pts]) for n,pts in series])\nif __name__=='__main__':\n save(1,[('HM',[(-.191,-.645)]),('CM',[(-.212,.137)]),('CE',[(.218,0)]),('JP',[(.232,.006)])])\nPY\npython extract.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
